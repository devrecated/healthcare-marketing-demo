# Copy to .env.local (gitignored). Never commit secret values.

# Preferred extract path (multimodal). Avoids AI Studio free-tier 503s.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional OpenRouter headers
# OPENROUTER_SITE_URL=https://your-app.vercel.app
# OPENROUTER_APP_NAME=Acme Healthcare scan demo

# Gemini (AI Studio) — fallback / PDF uploads
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase — shared supplies + usage_log for phone/laptop demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Scan microfrontend. On Vercel multi-service this defaults to /scan when unset.
# Local split-port: http://localhost:5173
NEXT_PUBLIC_SCAN_MFE_URL=http://localhost:5173
# Optional explicit origin override for CORS (defaults include localhost:5173)
# SCAN_MFE_ORIGIN=http://localhost:5173
