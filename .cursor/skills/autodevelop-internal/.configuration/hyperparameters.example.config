# Copyright (c) 2026 Devrecated
# Copy to .cursor/skills/<instance>/autodevelop/.configuration/hyperparameters.config
# Source knobs humans set. Each value has a comment and a documented range.
# Numbers stay inside the range. Use the enum where a number is the wrong type.
# When precision is low, or fields are missing, the expand-hyperparameters agent
# fills hyperparameters.yaml for the hosted MCP pre-query hook.
# Do not put secrets, tokens, or prices here.

# Whether this file is complete enough for the hook to consume directly.
# high = every source field below is set; the hook reads this file.
# low = sparse or draft; the hook reads the expanded hyperparameters.yaml.
# Enum: low | high
precision: high

# Sampling temperature for model-facing questions (creativity).
# Lower is more deterministic. Range: 0.0–2.0
temperature: 0.2

# How conservative the pre-query hook is when an answer could over-claim.
# 0 = cautious (cap temperature, require citations). 3 = permissive.
# Range: 0–3 (integer)
risk_level: 1

# Voice for injected system text. A number is the wrong type.
# Enum: professional | concise | coaching | formal
tone: professional

# Nucleus sampling cap for model calls the hook wraps.
# Range: 0.0–1.0
top_p: 1.0

# Maximum completion tokens on hooked chat calls.
# Range: 256–8192 (integer)
max_output_tokens: 1024

# Presence penalty on hooked chat calls.
# Range: -2.0–2.0
presence_penalty: 0

# Frequency penalty on hooked chat calls.
# Range: -2.0–2.0
frequency_penalty: 0

# Character cap for organization context injected into an ask (applied as a slice today).
# Range: 1000–32000 (integer)
context_budget: 12000

# Hits to retrieve before composing an answer or MCP search when the caller omits limit.
# Range: 1–50 (integer)
retrieval_limit: 8

# When 1, the hook requires ticket, file, or recap citations in the system prompt.
# Range: 0–1 (integer)
citation_required: 1

# Deadline for a hooked model call, in milliseconds.
# Range: 1000–120000 (integer)
timeout_ms: 30000

# Extra attempts after a transient model or tool failure.
# Range: 0–5 (integer)
retry_count: 1

# How firmly the hook restates tone and risk in the system prompt.
# Range: 0–3 (integer)
instruction_strength: 2

# Whether a request opens one generalized Autodevelop ticket or may split.
# consolidate = one broader ticket. split = up to ticket_max_per_request.
# Enum: consolidate | split
ticket_mode: consolidate

# Maximum Autodevelop tickets one request may open. Titles stay generalized.
# Range: 1–8 (integer)
ticket_max_per_request: 1
