# Copy to .env.local (gitignored). Never commit secret values.

# Host console (APIs + Supplies return URL).
# Leave blank in Vercel multi-service production (same origin).
# Local split-port default is applied automatically when unset.
VITE_API_BASE=http://localhost:3000
VITE_HOST_URL=http://localhost:3000

# Supabase — browser anon read of supplies (writes stay on host service role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
